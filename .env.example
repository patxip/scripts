# Copia este fichero como .env y rellena tus valores.
# Las líneas que empiezan por # son comentarios.

# --- Proveedor ---
PROVIDER=google                  # google | tomtom
API_KEY=pon_tu_clave_aqui

# --- Ruta ---
ORIGIN_LAT=40.453054
ORIGIN_LON=-3.688344

DEST_LAT=40.416775
DEST_LON=-3.703790

# Punto intermedio (opcional): descomenta y rellena si quieres forzar la ruta
# WAYPOINT_LAT=40.435000
# WAYPOINT_LON=-3.695000

# --- Umbrales ---
DELAY_THRESHOLD_MINUTES=10
